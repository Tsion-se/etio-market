# Public base URL of the deployed website (https in production, no trailing slash).
# Used by Telegram's "Open on website" link and for page metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram bot username WITHOUT the "@" (e.g. EthioMarketBot). It is public, so it is safe in
# NEXT_PUBLIC_*. Leave empty to turn off "Open in Telegram" links (the app keeps working).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Optional. Only if your Mini App is a "direct link" app created with BotFather /newapp:
# its short name gives https://t.me/<bot>/<short_name>?startapp=<product-id>.
# Leave empty to use the bot's main Mini App: https://t.me/<bot>?startapp=<product-id>.
NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=

# NEVER put a bot token or signing secret in a NEXT_PUBLIC_* variable: those are bundled
# into the browser. Secrets (needed later for server-side initData validation) must use
# server-only variables, e.g. TELEGRAM_BOT_TOKEN (not defined or used yet).
